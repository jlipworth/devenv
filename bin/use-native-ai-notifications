#!/usr/bin/env python3
"""Retire repo notification hooks without disturbing other local agent settings."""

import json
import os
import pathlib
import re
import sys
import tomllib


HOME = pathlib.Path.home()
SHIM = "ai-notify-if-unfocused"
CLAUDE_COMMAND = 'ai-notify-if-unfocused "Claude Code task finished"'


def atomic_write(path, content):
    import tempfile

    fd, name = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        os.fchmod(fd, path.stat().st_mode & 0o777)
        with os.fdopen(fd, "w") as out:
            out.write(content)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def codex():
    path = HOME / ".codex/config.toml"
    if not path.is_file():
        return
    content = path.read_text()
    lines = content.splitlines(keepends=True)
    in_tui = False
    saw_notifications = False
    saw_condition = False
    changed = False
    result = []
    for line in lines:
        if line.startswith("# Stable repo-managed notification shim installed by `make ai-tools`."):
            changed = True
            continue
        if line.startswith("# Native Codex TUI notifications are disabled because terminal-specific routing"):
            changed = True
            continue
        if line.startswith("# is handled by the repo-managed `ai-notify-if-unfocused` dispatcher above."):
            changed = True
            continue
        section = re.match(r"^\[([^]]+)\]\s*$", line)
        if section:
            in_tui = section.group(1) == "tui"
        if not in_tui and re.match(r"^notify\s*=", line) and SHIM in line:
            # The Codex app's computer-use integration wraps notify. Keep that
            # integration and only remove its former custom-notifier payload.
            if "--previous-notify" in line:
                match = re.search(r'("--previous-notify"\s*,\s*)("(?:\\.|[^"\\])*")', line)
                if match:
                    try:
                        previous = json.loads(tomllib.loads("value = " + match.group(2))["value"])
                        if isinstance(previous, list) and SHIM in previous:
                            previous = [item for item in previous if item != SHIM]
                            encoded = json.dumps(json.dumps(previous))
                            result.append(line[:match.start(2)] + encoded + line[match.end(2):])
                            changed = True
                            continue
                    except (ValueError, KeyError):
                        pass
                print(f"Could not safely update wrapped notify in {path}", file=sys.stderr)
            elif re.match(r'^notify\s*=\s*\[\s*"' + SHIM + r'"\s*\]\s*$', line.rstrip("\n")):
                changed = True
                continue
        if in_tui and re.match(r"^notifications\s*=", line):
            saw_notifications = True
            if line.strip() != "notifications = true":
                line = "notifications = true\n"
                changed = True
        if in_tui and re.match(r"^notification_condition\s*=", line):
            saw_condition = True
        result.append(line)
    if not saw_notifications or not saw_condition:
        found_tui = False
        for i, line in enumerate(result):
            if line.strip() == "[tui]":
                found_tui = True
                additions = []
                if not saw_notifications:
                    additions.append("notifications = true\n")
                if not saw_condition:
                    additions.append('notification_condition = "unfocused"\n')
                result[i + 1:i + 1] = additions
                changed = True
                break
        if not found_tui:
            result.extend(["\n[tui]\n", "notifications = true\n", 'notification_condition = "unfocused"\n'])
            changed = True
    if changed:
        atomic_write(path, "".join(result))
        print(f"Updated {path}")


def claude():
    path = HOME / ".claude/settings.json"
    if not path.is_file():
        return
    data = json.loads(path.read_text())
    changed = False
    hooks = data.get("hooks")
    if isinstance(hooks, dict) and isinstance(hooks.get("Stop"), list):
        old = hooks["Stop"]
        kept = []
        for entry in old:
            if not isinstance(entry, dict) or not isinstance(entry.get("hooks"), list):
                kept.append(entry)
                continue
            commands = [h for h in entry["hooks"] if not (isinstance(h, dict) and h.get("type") == "command" and h.get("command") == CLAUDE_COMMAND)]
            if len(commands) != len(entry["hooks"]):
                changed = True
            if commands:
                entry["hooks"] = commands
                kept.append(entry)
        if kept:
            hooks["Stop"] = kept
        else:
            hooks.pop("Stop", None)
        if not hooks:
            data.pop("hooks", None)
    if data.get("preferredNotifChannel") == "notifications_disabled":
        data["preferredNotifChannel"] = "auto"
        changed = True
    if changed:
        atomic_write(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        print(f"Updated {path}")


def unlink_legacy_helpers():
    for name in (SHIM, "ai-notify-relay-local", "ai-notify-relay-ensure-macos"):
        path = HOME / ".local/bin" / name
        if path.is_symlink() and "/notifications/" in str(path.resolve(strict=False)):
            path.unlink()
            print(f"Removed {path}")


if __name__ == "__main__":
    codex()
    claude()
    unlink_legacy_helpers()
